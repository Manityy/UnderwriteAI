# Groq API key for the Attack Agent (Agent 1).
# Get one at https://console.groq.com/keys and paste it below.
# Without it, the attack agent falls back to the built-in seed prompts.
#
# SECURITY: Never commit a real key. If a key was ever pasted in chat, Slack,
# or email, rotate it immediately in the Groq console and use a fresh one here.
GROQ_API_KEY=

# Secret used to sign the session cookie. Change this in production.
AUTH_SECRET=underwrite-ai-demo-secret-key-change-me
