generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String
  role         String       @default("INSURER")
  createdAt    DateTime     @default(now())
  assessments  Assessment[]
}

model Assessment {
  id         String   @id @default(cuid())
  clientName String
  industry   String   @default("Financial services")
  useCase    String   @default("")
  status     String   @default("DRAFT") // DRAFT | SCORED
  answers    String   @default("{}") // JSON string
  score          Int      @default(0)
  tier           String   @default("PENDING") // LOW | MEDIUM | HIGH | PENDING
  premiumFactor  Float    @default(0) // indicative multiplier, e.g. 1.45
  findings       String   @default("[]") // JSON Finding[]
  conditions     String   @default("[]") // JSON condition IDs or legacy strings
  scoreDrivers   String   @default("[]") // JSON ScoreDriver[] — why this score
  /** Underwriting decision: ACCEPT | ACCEPT_WITH_CONDITIONS | REFER | DECLINE | "" */
  decision       String   @default("")
  decisionNote   String   @default("")
  decisionAt     DateTime?
  attackPrompts     String    @default("[]") // JSON array of AttackPrompt
  attackGeneratedAt DateTime?
  testResults       String    @default("[]") // JSON array of TestResult (Judge Agent 2)
  testSummary       String    @default("{}") // JSON TestRunSummary
  testRanAt         DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}
