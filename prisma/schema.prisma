generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String
  role         String       @default("INSURER")
  createdAt    DateTime     @default(now())
  assessments  Assessment[]
}

model Assessment {
  id         String   @id @default(cuid())
  clientName String
  industry   String   @default("Financial services")
  useCase    String   @default("")
  status     String   @default("DRAFT") // DRAFT | SCORED
  answers    String   @default("{}") // JSON string
  score      Int      @default(0)
  tier       String   @default("PENDING") // LOW | MEDIUM | HIGH | PENDING
  findings   String   @default("[]") // JSON string
  conditions String   @default("[]") // JSON string
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}
